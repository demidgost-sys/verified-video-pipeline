{
  "$defs": {
    "engine": {
      "additionalProperties": false,
      "properties": {
        "informational": {
          "additionalProperties": false,
          "properties": {
            "build_ids": {
              "additionalProperties": false,
              "properties": {
                "ffmpeg": {
                  "$ref": "#/$defs/sha256"
                },
                "ffprobe": {
                  "$ref": "#/$defs/sha256"
                }
              },
              "required": [
                "ffmpeg",
                "ffprobe"
              ],
              "type": "object"
            },
            "platform": {
              "enum": [
                "Linux",
                "Darwin"
              ]
            }
          },
          "required": [
            "platform",
            "build_ids"
          ],
          "type": "object"
        },
        "required": {
          "additionalProperties": false,
          "properties": {
            "canary_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "ffmpeg": {
              "additionalProperties": false,
              "properties": {
                "libraries": {
                  "additionalProperties": false,
                  "properties": {
                    "libavcodec": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavfilter": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavformat": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavutil": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libswresample": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libswscale": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "libavutil",
                    "libavcodec",
                    "libavformat",
                    "libavfilter",
                    "libswscale",
                    "libswresample"
                  ],
                  "type": "object"
                },
                "version": {
                  "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "version",
                "libraries"
              ],
              "type": "object"
            },
            "ffprobe": {
              "additionalProperties": false,
              "properties": {
                "libraries": {
                  "additionalProperties": false,
                  "properties": {
                    "libavcodec": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavfilter": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavformat": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libavutil": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libswresample": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    },
                    "libswscale": {
                      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "libavutil",
                    "libavcodec",
                    "libavformat",
                    "libswscale",
                    "libswresample"
                  ],
                  "type": "object"
                },
                "version": {
                  "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "version",
                "libraries"
              ],
              "type": "object"
            },
            "loudness_profile": {
              "const": {
                "dual_mono": false,
                "id": "synthetic-web-loudness",
                "maximum_true_peak_dbtp": -1.0,
                "target_lufs": -16.0,
                "tolerance_lu": 1.0,
                "version": 1
              }
            },
            "profile": {
              "const": "h264-aac-web"
            },
            "render_contract_version": {
              "const": 2
            }
          },
          "required": [
            "ffmpeg",
            "ffprobe",
            "profile",
            "render_contract_version",
            "loudness_profile",
            "canary_sha256"
          ],
          "type": "object"
        },
        "schema_version": {
          "const": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "schema_version",
        "sha256",
        "required",
        "informational"
      ],
      "type": "object"
    },
    "loudness": {
      "additionalProperties": false,
      "properties": {
        "integrated_lufs": {
          "maximum": -15,
          "minimum": -17,
          "type": "number"
        },
        "method": {
          "const": "ffmpeg-loudnorm-input-v1"
        },
        "profile": {
          "const": {
            "dual_mono": false,
            "id": "synthetic-web-loudness",
            "maximum_true_peak_dbtp": -1.0,
            "target_lufs": -16.0,
            "tolerance_lu": 1.0,
            "version": 1
          }
        },
        "range_lu": {
          "maximum": 99,
          "minimum": 0,
          "type": "number"
        },
        "status": {
          "const": "PASS"
        },
        "threshold_lufs": {
          "maximum": 0,
          "minimum": -99,
          "type": "number"
        },
        "true_peak_dbtp": {
          "maximum": -1,
          "type": "number"
        }
      },
      "required": [
        "profile",
        "method",
        "status",
        "integrated_lufs",
        "true_peak_dbtp",
        "range_lu",
        "threshold_lufs"
      ],
      "type": "object"
    },
    "probe": {
      "additionalProperties": false,
      "properties": {
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "format_name": {
          "minLength": 1,
          "type": "string"
        },
        "streams": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "codec_name": {
                "minLength": 1,
                "type": "string"
              },
              "codec_type": {
                "enum": [
                  "audio",
                  "video"
                ]
              },
              "height": {
                "minimum": 1,
                "type": "integer"
              },
              "pix_fmt": {
                "minLength": 1,
                "type": "string"
              },
              "sample_rate": {
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "width": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "codec_type",
              "codec_name"
            ],
            "type": "object"
          },
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "duration_seconds",
        "format_name",
        "streams"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://github.com/demidgost-sys/verified-video-pipeline/raw/main/schemas/release-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_plan": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "const": "human-approved"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "sha256",
        "gate"
      ],
      "type": "object"
    },
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "profile": {
          "const": "h264-aac-web"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size",
        "profile",
        "probe",
        "engine"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "public_repository_fixture_policy": {
          "const": "synthetic-only"
        },
        "tool": {
          "const": "verified-video-pipeline"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "version",
        "public_repository_fixture_policy"
      ],
      "type": "object"
    },
    "qa": {
      "additionalProperties": false,
      "properties": {
        "checked_at": {
          "format": "date-time",
          "type": "string"
        },
        "checks": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "engine_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "loudness": {
          "$ref": "#/$defs/loudness"
        },
        "master_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "probe": {
          "$ref": "#/$defs/probe"
        },
        "status": {
          "const": "PASS"
        }
      },
      "required": [
        "status",
        "checked_at",
        "checks",
        "probe",
        "loudness",
        "engine_sha256",
        "master_sha256"
      ],
      "type": "object"
    },
    "release_id": {
      "pattern": "^sha256-[0-9a-f]{16}$",
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "source",
    "approved_plan",
    "artifact",
    "qa",
    "provenance"
  ],
  "title": "Verified Video Pipeline release manifest",
  "type": "object"
}
